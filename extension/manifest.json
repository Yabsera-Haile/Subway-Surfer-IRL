{
  "manifest_version": 3,
  "name": "Lane Runner Gestures",
  "version": "0.1.0",
  "description": "Play three-lane runner games with your body: step left or right, jump and duck in front of your webcam.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "webNavigation"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open gesture controls" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["inject.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
